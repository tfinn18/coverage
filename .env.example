# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API Keys (or "Connect" button on the project home).
# Both values are safe to expose to the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key. Never the service role / secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: the public URL of the deployed site, used to build auth redirect links.
# Leave blank locally; on Vercel set it to https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# ---- Local tests only (never set these on Vercel) ----
# Two ordinary test accounts, created in Supabase → Authentication → Users → Add user
# with "Auto Confirm User" ticked. Used by `npm run test:rls` and the Playwright test.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
